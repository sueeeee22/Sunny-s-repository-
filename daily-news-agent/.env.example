# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Claude / Anthropic ───────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail ────────────────────────────────────────────────────────────────────
# Your Gmail address (the one sending AND receiving the briefing)
GMAIL_ADDRESS=you@gmail.com

# Generate an App Password (not your main password) at:
# https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: send to a different address than GMAIL_ADDRESS
# RECIPIENT_EMAIL=you@example.com

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create a free app at https://developer.spotify.com/dashboard
# Add http://localhost:8888/callback as a Redirect URI in the app settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ── Ticketmaster ─────────────────────────────────────────────────────────────
# Free API key at: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
# Free tier allows 5,000 calls/day — sufficient for hundreds of artists.
TICKETMASTER_API_KEY=your_ticketmaster_api_key
